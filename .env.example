# ---------------------------------------------------------------------------
# LLM access.
#
# The pipeline speaks the OpenAI-compatible chat-completions API over plain
# HTTPS -- no vendor SDK -- so any provider offering that shape works by
# changing these three values. Nothing about a provider is hard-coded.
# ---------------------------------------------------------------------------

# The endpoint the pipeline POSTs to. It must end at the version segment; the
# pipeline appends /chat/completions itself.
LLM_BASE_URL=https://your-endpoint.example.com/v1

# The bearer token for that endpoint.
API_KEY=your-key-here

# Which model to ask. Optional; defaults to the value in pipeline/llm_client.py.
# LLM_MODEL=qwen3.6-flash
