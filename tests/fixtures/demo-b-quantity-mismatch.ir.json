        { "sourceType": "STATED", "sourceId": "NARRATION-B" },
        {
          "sourceType": "INFERRED",
          "sourceId": "NARRATION-B",
          "inferredBy": "evidence-to-ir-compiler",
          "confidence": 0.9,
          "rationale": "Narration states 'the invoice quantity is greater than the quantity actually received. Finance must not release it.' The rule's operator is deliberately modeled as invoiceQuantity <= receivedQuantity (the condition that ALLOWS release), so the observed WAREHOUSE_REVIEW outcome corresponds to this condition evaluating false — matching the documented Processing Rules sheet's 'Quantity Requirement: invoice quantity must not exceed received quantity'. This is exactly the kind of comparison that risks accidental operator reversal (>, >=) if left as free text; encoding it structurally with named operands avoids that failure mode."
        }
      ]
    }
