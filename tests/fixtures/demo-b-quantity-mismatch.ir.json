      "id": "RULE-QUANTITY-REQUIREMENT",
      "type": "BusinessRule",
      "name": "Quantity Requirement",
      "condition": {
        "operator": "<=",
        "left": { "ref": "VAR-INVOICE-QTY" },
        "right": { "ref": "VAR-RECEIVED-QTY" }
      },
      "provenance": [
        {
          "sourceType": "OBSERVED",
          "sourceId": "E104"
        },
        {
          "sourceType": "OBSERVED",
          "sourceId": "E107"
