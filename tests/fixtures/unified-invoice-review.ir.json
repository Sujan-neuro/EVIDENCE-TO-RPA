  "process": {
    "id": "PROC-INVOICE-REVIEW",
    "type": "Process",
    "intent": "Determine whether a blocked invoice can be released, checking purchase-order existence, quantity agreement, and price tolerance in that priority order",
    "provenance": [
      {
        "sourceType": "STATED",
        "sourceId": "MISSING_PO:NARRATION-1"
      },
      {
        "sourceType": "STATED",
        "sourceId": "QTY_MISMATCH:NARRATION-2"
      },
      {
        "sourceType": "STATED",
        "sourceId": "PRICE_TOLERANCE:NARRATION-3"
      },
      {
        "sourceType": "STATED",
        "sourceId": "EVERYTHING_CORRECT:NARRATION-5"
      },
      {
        "sourceType": "STATED",
        "sourceId": "PRICE_EXCESS:NARRATION-6"
      },
      {
        "sourceType": "INFERRED",
        "sourceId": "cross-demonstration-outcome-analysis",
        "inferredBy": "human-analyst",
        "confidence": 0.9,
        "rationale": "No single demonstration states an explicit priority order across all three checks. This sequence (PO existence, then quantity, then price) was inferred by checking it against all 6 recorded outcomes: it correctly predicts MANUAL_REVIEW, WAREHOUSE_REVIEW, PROCUREMENT_REVIEW, and RELEASED in every recorded case, including cases where the SME's own trace skipped a check entirely (e.g. price-excess never visits Goods Receipts, quantity-mismatch never visits Purchase Orders' price) -- read as the SME already knowing, from blockReason, which single check was relevant, not as evidence that only one check should ever run. See ir/README.md for the full reasoning and its stated limitation."
      }
    ]
  },
